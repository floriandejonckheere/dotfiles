Host *
	UseKeychain	yes
	AddKeysToAgent	yes
	IdentityFile	~/.ssh/nephroflow-ssh-key

Host *.teleport.nephroflow.com
	User nephroflow
	HostName %h
	Port 3022
	ProxyCommand ssh -p 3023 %r@teleport.nephroflow.com -s proxy:%h:%p

Host *.ndte.teleport.sh
	User nephroflow
	HostName %h
	Port 3022
	ProxyCommand ssh -p 3023 %r@ndte.teleport.sh -s proxy:%h:%p
